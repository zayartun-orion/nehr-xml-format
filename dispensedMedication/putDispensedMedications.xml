<?xml version="1.0" encoding="UTF-8"?>
<!-- Dispensed Medications contributed via putDispensedMedications. Corrected from record 1 of
     /nehr/xml/dispensedmed (7 Aug 2026 snapshot — the endpoint still served no data on 9 Aug).
     Validates against schemas/putDispensedMedications_Request.xsd.
     TO CONFIRM WITH SYNAPXE: namespace still http://www.mohh.com/nehr (our XSD copy is the 2023Q4 build).
     See FIXES.md in this folder for every change and the open items.

     ⚠️ THE medicationItem BLOCK BELOW IS A SKELETON, NOT DATA. The source sends <MedicationItems />
     — empty — in all 16 records. Every value marked TODO_ must come from the source system; the
     codeset names and worked examples in the comments ARE documented and can be used as-is.

     ⚠️ DO NOT reuse the putOrderedMedications medicationItem serializer here. This service's item has
     medicationItemDispensedDate (not …OrderedDate), quantityDispensed (not quantityOrdered), and has
     NO medicationDiscontinuedDateTime and NO additionalDosageInstruction. -->
<putDispensedMedications xmlns="http://www.mohh.com/nehr">
	<controlHeader>
		<srcInstitution>9403258</srcInstitution>
		<licenseeNumber>L/9403258/MDS/007/242</licenseeNumber>
		<srcApplication>MDX-GCMS</srcApplication>
		<!-- The source truncates msgID at 29 chars ("MDX-GCMS-eb763d6b-fc51-4c34-a"), so the tail of
		     the real GUID is unrecoverable from the payload. Emit the full GUID, unprefixed. -->
		<msgID>eb763d6b-fc51-4c34-a000-000000000000</msgID>
		<msgSequenceID>1</msgSequenceID>
		<msgDateTime>2026-08-07T22:40:35+08:00</msgDateTime>
	</controlHeader>
	<patient>
		<identification>
			<id>S2735943D</id>
			<MRNNumber>MDX-GCMS^13034023</MRNNumber>
			<type>SP</type>
		</identification>
		<name>
			<value>GATCHALIAN FERDINAND PAGUIO</value>
			<title>Mr</title>
		</name>
		<dateOfBirth>1965-12-30</dateOfBirth>
		<!-- UNRESOLVED — do not bulk-convert gender yet. Template samples M/F/U; the NHDD sample
		     subset says C=Female, D=Male, E=Unknown; the live system emits C/D. See FIXES.md. -->
		<gender>M</gender>
		<nationality>PH</nationality>
		<maritalStatus>2</maritalStatus>
	</patient>
	<medicationDispense>
		<recordIdentifier>dsp-rec-00899ce2-8d28-4caa-b0d5-300b0d7c454b1</recordIdentifier>
		<!-- ⭑ eventID with a CAPITAL D in this service. The "evt-" prefix must be stripped — the value
		     has to match the putEvent event/id byte for byte or the dispense links to no visit. -->
		<eventID>0708202610131124913034023</eventID>
		<!-- ADDED (cross-referenced, not invented): the orderedmed payload's record for this same
		     patient, event and sourceGroupingID carries orderID 0708202610131124913034023. Populating
		     it here is what links this dispense to the order it was dispensed against. Optional in the
		     template, but without it NEHR cannot associate the two. Vendor to confirm the linkage. -->
		<orderID>0708202610131124913034023</orderID>
		<sourceGroupingID>visit-0708202610131124913034023</sourceGroupingID>
		<!-- ADDED: Optional, but known — the same clinic ordered and dispensed. -->
		<orderingInstitution>9403258</orderingInstitution>
		<orderingLocation>
			<textDescription>Consultation Room 1</textDescription>
		</orderingLocation>
		<orderedBy>
			<!-- ADDED: the source sends orderedBy with a name but no id. id is Optional here, but the
			     clinician's MCR is known from the same payload's authorizedBy. -->
			<id>M03009J</id>
			<name>PHILIP KOH</name>
		</orderedBy>
		<dispenseID>MDX-GCMS-DSP-00899ce2-8d28-4caa-b0d5-300b0d7c454b1</dispenseID>
		<!-- ADDED — Mandatory and absent from the source. Template: "If source has its own pharmacy
		     system, the source institution will be populated into this field", priority HCI code. -->
		<dispensingInstitution>9403258</dispensingInstitution>
		<dispensingLocation>
			<textDescription>Heart Clinic Dispensary — Main Counter</textDescription>
		</dispensingLocation>
		<dispenseType>
			<code>Outpatient</code>
			<codingSchemeName>Med_Order_Dispense_Type_(NEHR)</codingSchemeName>
			<textDescription>Outpatient</textDescription>
		</dispenseType>
		<!-- ⚠️ This is the message-generation time (22:40), not the dispensing time. The event id
		     decodes to 07 Aug 2026 10:13:11.249, so the real visit was at 10:13. Template also requires
		     dispenseDateTime >= the latest medicationItemDispensedDate in this list. -->
		<dispenseDateTime>2026-08-07T22:40:35+08:00</dispenseDateTime>
		<dispenseStatus>
			<code>Completed</code>
			<codingSchemeName>Med_Status_(NEHR)</codingSchemeName>
			<textDescription>Completed</textDescription>
		</dispenseStatus>
		<!-- ADDED — Mandatory, sent as an empty <DispensedBy /> by the source. Template: "must be a
		     clinician who dispenses the medications. In case the dispense is managed by clinic
		     assistant, it should still be mapped with the licensed clinician details (MCR number &
		     name)." For this clinic that is the attending doctor. Vendor to confirm. -->
		<dispensedBy>
			<id>M03009J</id>
			<name>PHILIP KOH</name>
		</dispensedBy>
		<authorizedBy>
			<id>M03009J</id>
			<name>PHILIP KOH</name>
		</authorizedBy>
		<!-- ============================ SKELETON STARTS ============================
		     medicationItem is Mandatory 1…* — a message without one cannot validate, which is why the
		     current output fails. Repeat this block once per drug dispensed.
		     Numeric and date fields carry shape-only values (a TODO_ string would break the
		     xs:decimal / xs:dateTime types); the codeset names are real. -->
		<medicationItem>
			<itemId>TODO_ITEM_ID</itemId>
			<sequenceNo>1</sequenceNo>
			<!-- Mandatory. Only populate when the source stores dose/frequency as concatenated free
			     text; otherwise put those in the discrete fields below. -->
			<dosageInstruction>TODO_DOSAGE_INSTRUCTION</dosageInstruction>
			<doseQuantity>
				<lowValue>1</lowValue>
				<lowUnit>TODO_DOSE_UNIT</lowUnit>
			</doseQuantity>
			<!-- ⭑ …DispensedDate here, NOT medicationItemOrderedDate (that is putOrderedMedications). -->
			<medicationItemDispensedDate>2026-08-07T10:13:11+08:00</medicationItemDispensedDate>
			<medicationItemStatus>
				<code>New</code>
				<codingSchemeName>Med_Status_(NEHR)</codingSchemeName>
				<textDescription>New</textDescription>
			</medicationItemStatus>
			<!-- ⭑ quantityDispensed, NOT quantityOrdered. ⚠️ Must be NEGATIVE when
			     medicationItemStatus = "Returned". -->
			<quantityDispensed>1</quantityDispensed>
			<quantityDispensedUnits>TODO_QUANTITY_UNIT</quantityDispensedUnits>
			<!-- durationUOM is Mandatory only when "duration" is populated. SMST duration units,
			     verified in standards/SMST_20260402.xlsx: d = day, wk = week, mo = month.
			     Out of SMST scope -> code "NoSMST", codingSchemeName "NON_SMST_(NEHR)". -->
			<durationUOM>
				<code>d</code>
				<codingSchemeName>Med_UnitofMeasure_(NEHR)</codingSchemeName>
				<textDescription>day</textDescription>
			</durationUOM>
			<!-- Drug code from the Singapore Drug Dictionary
			     (standards/SDD_Ambulatory_Care_Private_Prescribing_Subset_20260521.xlsx).
			     Out of SDD scope -> code "NONHSAMANAGED", scheme "Non_Singapore_Drug_Dictionary_(NEHR)".
			     ⚠️ Cross-check code against textDescription before sending — the PML payload had a
			     code/description mismatch (JANUMET vs JANUMET XR). See ../medicationlist/FIXES.md. -->
			<medicationName>
				<code>TODO_SDD_CONCEPT_ID</code>
				<codingSchemeName>Singapore Drug Dictionary</codingSchemeName>
				<textDescription>TODO_DRUG_NAME_AS_SHOWN_TO_CLINICIAN</textDescription>
			</medicationName>
			<!-- SMST frequency, e.g. 229799001 = "2 times a day", 229797004 = "once a day". -->
			<frequency>
				<code>TODO_SMST_FREQUENCY_CODE</code>
				<codingSchemeName>Med_Frequency_(NEHR)</codingSchemeName>
				<textDescription>TODO_FREQUENCY_TEXT</textDescription>
			</frequency>
			<!-- SMST route, e.g. 26643006 = Oral. -->
			<routeOfAdministration>
				<code>TODO_SMST_ROUTE_CODE</code>
				<codingSchemeName>Med_RouteofAdmin_(NEHR)</codingSchemeName>
				<textDescription>TODO_ROUTE_TEXT</textDescription>
			</routeOfAdministration>
			<!-- SMST dose form, e.g. 421026006 = Tablet, 420627008 = Extended-Release Tablet.
			     doseForm itself is Optional, but if sent, code + scheme + text are all Mandatory. -->
			<doseForm>
				<code>TODO_SMST_DOSE_FORM_CODE</code>
				<codingSchemeName>Med_DoseForm_(NEHR)</codingSchemeName>
				<textDescription>TODO_DOSE_FORM_TEXT</textDescription>
			</doseForm>
		</medicationItem>
		<!-- ============================= SKELETON ENDS ============================= -->
	</medicationDispense>
</putDispensedMedications>
