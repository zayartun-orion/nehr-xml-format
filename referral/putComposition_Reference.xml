    <msgID>MDX-GCMS-REF-20260707-00001</msgID>    <!-- [M] card 1     String(50)  Unique GCMS-generated message ID -->
    <msgSequenceID>498</msgSequenceID>    <!-- [M] card 1     Numeric(15) Monotonic per (dataType, srcApplication, srcInstitution) -->
    <msgDateTime>2026-07-07T18:05:12+08:00</msgDateTime>    <!-- [M] card 1     DateTime    Message-construction time; +08:00 SG -->
  </controlHeader>

  <patient>    <!-- [M] card 1     Grouping    Same continuity patient as med/allergy samples -->
    <identification>      <!-- [M] card 1     Grouping -->
      <id>S5512345A</id>      <!-- [M] card 0..1  String(40)  NRIC, uppercase -->
      <MRNNumber>MDX-GCMS^13007891</MRNNumber>      <!-- [M] card 1     String(60)  GCMS internal MRN, prefixed with srcApplication -->
      <type>SP</type>      <!-- [M] card 0..1  String(128) NHDD ID type: SP = Singapore Pink (Citizen) -->
    </identification>
    <name>      <!-- [M] card 0..1  Grouping -->
      <value>TAN AH BENG</value>      <!-- [M] card 0..1  String(128) Patient legal name from Tbl_PatientParticular -->
      <title>MR</title>      <!-- [O] card 0..1  String(10) -->
    </name>
    <dateOfBirth>1955-03-15</dateOfBirth>    <!-- [M] card 0..1  Date        71 y/o -->
    <gender>M</gender>    <!-- [M] card 0..1  String(128) NHDD: M = Male -->
