          </encounter>
          <dateSent>2026-07-07T17:55:00</dateSent>          <!-- [O] card 0..1  DateTime -->
          <reason>            <!-- [O] card 0..1  Grouping -->
            <textDescription>Paroxysmal atrial fibrillation, symptomatic despite rate control</textDescription>            <!-- [M] card 0..1  CLOB -->
