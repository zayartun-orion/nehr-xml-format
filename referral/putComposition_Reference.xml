          <description>Referred for electrophysiology assessment and consideration of catheter ablation. Symptomatic paroxysmal AF with breakthrough episodes on bisoprolol; CHA2DS2-VASc 3, anticoagulated on apixaban.</description>          <!-- [O] card 0..1  CLOB -->
          <serviceRequested>            <!-- [O] card 0..*  Grouping -->
            <code>NEHR_SS_0002</code>
            <codingSchemeName>Service_Specialty_(NEHR)</codingSchemeName>
            <textDescription>Cardiology - Electrophysiology</textDescription>
          </serviceRequested>
        </referralRequest>
