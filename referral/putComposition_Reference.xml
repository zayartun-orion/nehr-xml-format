    <srcInstitution>9403258</srcInstitution>    <!-- [M] card 1     String      HCI code, Heart Clinic main branch -->
    <licenseeNumber>L/9403258/MDS/007/242</licenseeNumber>    <!-- [M] card 0..1  String(50)  HSCA Licensee (Item 5, Config Checklist) -->
