      <codingSchemeName>Document_Status_(NEHR)</codingSchemeName>      <!-- [M] card 0..1  String(50) -->
      <textDescription>Finalized</textDescription>      <!-- [M] card 0..1  CLOB -->
    </status>

    <creator>      <!-- [M] card 1     Grouping    Who created the record in GCMS -->
      <practitioner>        <!-- [M] card 0..1  Grouping    (normal spelling HERE — sic only inside referralRequest) -->
        <identifier>04173D</identifier>        <!-- [M] card 0..1  String      MCR of Dr Ruth Kam -->
        <name>DR RUTH KAM</name>        <!-- [M] card 0..1  String(80) -->
      </practitioner>
    </creator>

    <author>      <!-- [M] card 1..*  Grouping    Clinically responsible for the content -->
      <practitioner>
        <identifier>04173D</identifier>
        <name>DR RUTH KAM</name>
      </practitioner>
    </author>

    <custodian>      <!-- [M] card 1     Grouping    Org that maintains the source record -->
      <identifier>9403258</identifier>      <!-- [M] card 0..1  String(50)  HCI code (falls back to HSCA licensee) -->
      <location>        <!-- [O] card 0..*  Grouping -->
        <name>Ruth Kam Heart and Arrhythmia Clinic</name>        <!-- [M] card 0..1  String(200) -->
      </location>
    </custodian>

    <!-- Ties the referral to the visit at which it was raised. MUST equal the
         putEvent event id for the same encounter.
         [GCMS] Tbl_PatientAppointment.Appointment_ID                          -->
    <encounter>      <!-- [O] card 0..1  Grouping -->
      <identifier>7f3a9c21-88e4-4b1d-9a6e-3c5d10f2b4a8</identifier>      <!-- [M] card 1  String(1995) -->
      <period>        <!-- [O] card 0..1  Grouping -->
        <start>2026-07-07T16:30:00</start>        <!-- [O] card 0..1  DateTime -->
        <end>2026-07-07T17:10:00</end>        <!-- [O] card 0..1  DateTime -->
      </period>
    </encounter>

    <!-- ======================================================================
         SECTION 1 — the structured referral request.
