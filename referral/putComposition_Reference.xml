    <date>2026-07-07T17:55:00</date>    <!-- [M] card 1     DateTime    Last-updated timestamp of this version -->
    <createdDate>2026-07-07T17:55:00</createdDate>    <!-- [M] card 1     DateTime    First-created timestamp -->

    <type>      <!-- [M] card 1     Grouping    What kind of document this is -->
      <code>ReferralNote</code>      <!-- [M] card 0..1  String(50)  Fixed for referral memoranda -->
      <codingSchemeName>Document_Type_(NEHR)</codingSchemeName>      <!-- [M] card 0..1  String(50) -->
      <textDescription>Referral Note</textDescription>      <!-- [M] card 0..1  CLOB -->
    </type>

    <title>Referral to National Heart Centre Singapore - Electrophysiology</title>    <!-- [M] card 0..1  String(200) -->

    <status>      <!-- [M] card 1     Grouping    Final | Corrected | Cancelled -->
