<?xml version="1.0" encoding="UTF-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════════════════════
     Referral Note — contributed via putComposition (RefNotes variant)

     Corrected from record 1 of /nehr/xml/referral, fetched LIVE on 19 Aug 2026 (20 records,
     233 KB, HTTP 200). Validates against schemas/putComposition_Request.xsd.

     NOTE: the service is putComposition, not "putReferral". Referral notes are one of several
     document kinds carried by putComposition; the mapping template is
     putComposition_v0.2_(RefNotes)_20251224.xlsx.

     ⚠️ THE REFERRAL LETTER ITSELF IS MISSING. The source sends <file /> — empty — in all 20
     records, while the template marks file Mandatory 1. So the message announces an attachment
     and carries no attachment. Marked TODO_BASE64_ENCODED_PDF below; it is the headline blocker.

     TO CONFIRM WITH SYNAPXE: namespace still http://www.mohh.com/nehr (our XSD copy is the
     2023Q4 build). See FIXES.md in this folder for every change and the open items.
     ═══════════════════════════════════════════════════════════════════════════════════════════ -->
<putComposition xmlns="http://www.mohh.com/nehr">
	<!-- This service's controlHeader is INLINE and has NO msgType — the source correctly omits it.
	     37 permitted srcApplication values; MDX-GCMS is not among them (registration pending). -->
	<controlHeader>
		<srcInstitution>9403258</srcInstitution>
		<licenseeNumber>L/9403258/MDS/007/242</licenseeNumber>
		<srcApplication>MDX-GCMS</srcApplication>
		<!-- The source truncates msgID at 20 chars ("b8a1bdb8-6f42-4a3f-8"), so the tail of the real
		     GUID is unrecoverable from the payload. Emit the full GUID, unprefixed. maxLength 50. -->
		<msgID>b8a1bdb8-6f42-4a3f-8000-000000000000</msgID>
		<msgSequenceID>1</msgSequenceID>
		<msgDateTime>2026-08-19T18:28:58+08:00</msgDateTime>
	</controlHeader>
	<patient>
		<identification>
			<id>C8974431</id>
			<MRNNumber>MDX-GCMS^13001997</MRNNumber>
			<!-- ⚠️ UNRESOLVED: "SP" means Singapore NRIC, but C8974431 is not an NRIC format and the
			     patient's nationality is ID (Indonesia). This is almost certainly a foreign document
			     needing FP or MP. Left as the source value because the correct code depends on which
			     document was actually presented at registration — the clinic must set it from that,
			     not from a fixed default. See FIXES.md. -->
			<type>SP</type>
		</identification>
		<name>
			<value>TAN RATNA MULYATI</value>
			<!-- Template sample has no trailing period: "Ms" not "Ms." -->
			<title>Ms</title>
		</name>
		<!-- contactDetails omitted: the source sends <address /> and <phone /> both empty, and the
		     Readme forbids empty tags. -->
		<dateOfBirth>1962-03-31</dateOfBirth>
		<!-- UNRESOLVED — do not bulk-convert gender yet. Template samples M/F/U; the NHDD sample
		     subset says C=Female, D=Male, E=Unknown; the live system emits C/D. If the real NHDD
		     uses C/D/E, changing this breaks a correct mapping. Left as sent. See FIXES.md. -->
		<gender>C</gender>
		<nationality>ID</nationality>
		<!-- race omitted: Mandatory in the template but sent empty in all 20 records. Fabricating it
		     would be worse than omitting it. Real data gap at registration. -->
		<!-- language omitted: sent empty. -->
		<maritalStatus>2</maritalStatus>
	</patient>
	<composition>
		<identifier>064e86ee-bed8-4043-a504-335ddcc98c4e1</identifier>
		<!-- Template format CCYY-MM-DDThh:mm:ss+08:00 — whole seconds. The source emits 7-digit
		     fractional seconds (…58.6675902+08:00). -->
		<date>2026-08-19T18:28:58+08:00</date>
		<createdDate>2026-08-19T18:28:58+08:00</createdDate>
		<type>
			<code>ReferralNote</code>
			<codingSchemeName>Document_Type_(NEHR)</codingSchemeName>
			<textDescription>Referral Note</textDescription>
		</type>
		<title>Referral to National Heart Centre Singapore - Electrophysiology</title>
		<status>
			<code>Final</code>
			<codingSchemeName>Document_Status_(NEHR)</codingSchemeName>
			<textDescription>Finalized</textDescription>
		</status>
		<!-- practitionerType = practitioner > identifier + name. Nothing else.
		     The source adds <profession> (with an empty <coding/>) and a stray <system /> — neither
		     exists in this schema. Both removed. -->
		<creator>
			<practitioner>
				<identifier>M03009J</identifier>
				<name>PHILIP KOH</name>
			</practitioner>
		</creator>
		<!-- ⭑ The source names this child <compositionPractitioner>. The schema and the template both
		     say <practitioner> — the same element name as in creator. -->
		<author>
			<practitioner>
				<identifier>M03009J</identifier>
				<name>PHILIP KOH</name>
			</practitioner>
		</author>
		<custodian>
			<identifier>9403258</identifier>
			<location>
				<name>The Heart Clinic</name>
			</location>
		</custodian>
		<encounter>
			<!-- Template: same event id and format as putEvent. The source sends a GUID
			     (71b3b8e8-…-4eaad906ef2a) which links this referral to no visit. -->
			<identifier>TODO_PUTEVENT_EVENT_ID</identifier>
			<period>
				<start>2026-08-19T18:28:58+08:00</start>
				<end>2026-08-19T18:58:58+08:00</end>
			</period>
		</encounter>

		<!-- ═══════════════════════════════════════════════════════════════════════════════════
		     SECTIONS. The schema declares ONE repeating element, <section>, of type sectionType.
		     The source invents five differently-named wrappers instead — CodeSection,
		     PatientInformationSection, ClinicalInformationSection, ReferralInformationSection,
		     AttachmentSection — none of which exist. Each is a <section>.
		     Each section carries exactly 1 title, 1 code and 1 content (template row 132).
		     ═══════════════════════════════════════════════════════════════════════════════════ -->

		<!-- Section 1 — the referral request itself.
		     No <title>: template row 133 says "Do not populate when content.referralRequest is
		     populated." The source correctly omits it here. -->
		<section>
			<code>
				<code>4</code>
				<codingSchemeName>Section_Code_(NEHR)</codingSchemeName>
				<textDescription>Referral Letter</textDescription>
			</code>
			<content>
				<referralRequest>
					<status>
						<code>1</code>
						<codingSchemeName>Referral_Status_(NEHR)</codingSchemeName>
						<textDescription>Authorized</textDescription>
					</status>
					<identifier>MDX-GCMS-REF-000000412</identifier>
					<type>
						<code>4</code>
						<codingSchemeName>Referral_Type_(NEHR)</codingSchemeName>
						<textDescription>Consultation</textDescription>
					</type>
					<specialty>
						<code>NEHR_SS_0002</code>
						<codingSchemeName>Service_Specialty_(NEHR)</codingSchemeName>
						<textDescription>Cardiology</textDescription>
					</specialty>
					<!-- ⭑⭑ TWO SPELLINGS THAT LOOK LIKE MISTAKES BUT ARE NOT.
					     <practitoner> is missing an "i", and <organisation> uses the British "s".
					     Both are spelled that way in Synapxe's XSD *and* in the mapping template
					     (rows 558, 562, 568, 572), so they are authoritative. The source "fixed"
					     them to <practitioner> and <organization> and thereby broke them. -->
					<requester>
						<practitoner>
							<identifier>M03009J</identifier>
							<name>PHILIP KOH</name>
						</practitoner>
						<!-- requester/organisation is identifierType: identifier + name ONLY.
						     The source also sends <type> here, which exists only under
						     recipient/organisation. Removed. -->
						<organisation>
							<identifier>9403258</identifier>
							<name>The Heart Clinic</name>
						</organisation>
					</requester>
					<recipient>
						<!-- recipient/organisation is organisationType, which DOES allow <type>. -->
						<organisation>
							<identifier>0116</identifier>
							<name>National Heart Centre Singapore</name>
							<type>
								<code>2</code>
								<codingSchemeName>Organisation_Type_(NEHR)</codingSchemeName>
								<textDescription>Healthcare Provider</textDescription>
							</type>
						</organisation>
					</recipient>
					<!-- referralRequest/encounter holds ONLY <identifier>. The source nests a
					     <period> here, which the schema does not allow at this level. -->
					<encounter>
						<identifier>TODO_PUTEVENT_EVENT_ID</identifier>
					</encounter>
					<dateSent>2026-08-19T18:28:58+08:00</dateSent>
					<!-- reason omitted: the source sends <reason /> empty. Empty tags are forbidden. -->
					<serviceRequested>
						<code>NEHR_SS_0002</code>
						<codingSchemeName>Service_Specialty_(NEHR)</codingSchemeName>
						<textDescription>Cardiology - Electrophysiology</textDescription>
					</serviceRequested>
				</referralRequest>
			</content>
		</section>

		<!-- Section 2 — Patient Information.
		     The source sends code "Active" on Diagnosis_Status_(NEHR) here — a diagnosis-status
		     code in a section-code slot, on every notes section. Wrong codeset entirely.
		     Section_Code_(NEHR) documents a code only for the Referral Letter section ("4"), so
		     these sections carry textDescription alone; the inner code is Optional and
		     codingSchemeName may only be sent when code is. TO CONFIRM: whether Synapxe expects
		     code "1" (Referral Notes Item) on these instead. See FIXES.md. -->
		<section>
			<title>Patient Information</title>
			<code>
				<textDescription>Patient Information</textDescription>
			</code>
			<content>
				<!-- ⭑ The source wraps these in <Others>…</Others> in this one section (and omits the
				     wrapper in the others). No such level exists — <other> repeats directly. -->
				<other>
					<code>
						<code>1</code>
						<codingSchemeName>Other_Code_(NEHR)</codingSchemeName>
						<textDescription>Notes Item</textDescription>
					</code>
					<extension>
						<notesItem>
							<name>Full Name</name>
							<text>TAN RATNA MULYATI</text>
						</notesItem>
					</extension>
				</other>
				<other>
					<code>
						<code>1</code>
						<codingSchemeName>Other_Code_(NEHR)</codingSchemeName>
						<textDescription>Notes Item</textDescription>
					</code>
					<extension>
						<notesItem>
							<name>NRIC</name>
							<text>C8974431</text>
						</notesItem>
					</extension>
				</other>
				<other>
					<code>
						<code>1</code>
						<codingSchemeName>Other_Code_(NEHR)</codingSchemeName>
						<textDescription>Notes Item</textDescription>
					</code>
					<extension>
						<notesItem>
							<name>Gender</name>
							<text>Female</text>
						</notesItem>
					</extension>
				</other>
				<!-- ⚠️ THE SOURCE EMITS TWO MORE <Other> BLOCKS HERE, both named "Full Name" and both
				     with NO <text>. notesItem requires name AND text (both Mandatory 1), so they are
				     invalid; they are also duplicates of the first entry. Across the payload this
				     pattern accounts for 60 of the 180 notes items. Dropped — see FIXES.md, which
				     describes the loop bug that produces them. -->
			</content>
		</section>

		<!-- Section 3 — Clinician Information. -->
		<section>
			<title>Clinician Information</title>
			<code>
				<textDescription>Clinician Information</textDescription>
			</code>
			<content>
				<other>
					<code>
						<code>1</code>
						<codingSchemeName>Other_Code_(NEHR)</codingSchemeName>
						<textDescription>Notes Item</textDescription>
					</code>
					<extension>
						<notesItem>
							<name>Referring Clinician</name>
							<text>PHILIP KOH (MCR M03009J)</text>
						</notesItem>
					</extension>
				</other>
				<other>
					<code>
						<code>1</code>
						<codingSchemeName>Other_Code_(NEHR)</codingSchemeName>
						<textDescription>Notes Item</textDescription>
					</code>
					<extension>
						<notesItem>
							<name>Clinic</name>
							<text>The Heart Clinic</text>
						</notesItem>
					</extension>
				</other>
			</content>
		</section>

		<!-- Section 4 — Referral Information.
		     The source's only real entry here is "Reason for Referral" = "N/A". The Readme
		     explicitly forbids placeholder values such as NA, so the whole notes item is dropped
		     rather than contributed as text. If the clinic captures a real referral reason, send
		     it here — and consider also populating referralRequest/reason, which is coded. -->
		<section>
			<title>Referral Information</title>
			<code>
				<textDescription>Referral Information</textDescription>
			</code>
			<content>
				<other>
					<code>
						<code>1</code>
						<codingSchemeName>Other_Code_(NEHR)</codingSchemeName>
						<textDescription>Notes Item</textDescription>
					</code>
					<extension>
						<notesItem>
							<name>Reason for Referral</name>
							<text>TODO_REAL_REFERRAL_REASON</text>
						</notesItem>
					</extension>
				</other>
			</content>
		</section>

		<!-- Section 5 — the attachment. -->
		<section>
			<title>Referral Letter Attachment</title>
			<code>
				<textDescription>Referral Letter Attachment</textDescription>
			</code>
			<content>
				<other>
					<code>
						<!-- ⭑ Other_Code_(NEHR): 1 = Notes Item, 2 = File Attachment. The source sends
						     code 1 with the description "File Attachment" — code and description
						     disagree. For an attachment the code is 2. -->
						<code>2</code>
						<codingSchemeName>Other_Code_(NEHR)</codingSchemeName>
						<textDescription>File Attachment</textDescription>
					</code>
					<extension>
						<fileAttachment>
							<contentType>
								<code>1</code>
								<codingSchemeName>Attachment_Content_Type_(NEHR)</codingSchemeName>
								<!-- Mandatory; the source sends <textDescription /> empty. 1 = PDF. -->
								<textDescription>PDF</textDescription>
							</contentType>
							<!-- ⭑ The source spells this <langauge> — the same typo as putCardiology.
							     Schema and template both spell it <language>. -->
							<language>
								<code>EN</code>
								<codingSchemeName>Attachment_Language_(NEHR)</codingSchemeName>
								<textDescription>English</textDescription>
							</language>
							<!-- 🛑 THE BLOCKER. Mandatory 1, and the source sends <file /> empty in all
							     20 records. This must be the base64-encoded referral letter PDF.
							     putCardiology already encodes attachments correctly — reuse that code:
							     base64 of the raw bytes, and <size> = the DECODED byte count. -->
							<file>TODO_BASE64_ENCODED_PDF</file>
							<size>0</size>
							<!-- Template row 638 gives the naming convention when the source does not
							     generate a name: <DD-MMM-YYYY>_<Document Title>. -->
							<title>19-Aug-2026_Referral Letter</title>
							<sequenceId>1</sequenceId>
						</fileAttachment>
					</extension>
				</other>
			</content>
		</section>
	</composition>
</putComposition>
