        <code>4</code>        <!-- [O] card 0..1  String(50)  4 = Referral Letter -->
        <codingSchemeName>Section_Code_(NEHR)</codingSchemeName>
        <textDescription>Referral Letter</textDescription>        <!-- [M] card 0..1  CLOB -->
      </code>
      <content>        <!-- [M] card 1     Grouping -->
        <referralRequest>          <!-- card 0..*, max 1 per referral letter -->
          <status>            <!-- [M] card 1     Grouping -->
            <code>1</code>            <!-- [M] card 0..1  String(50)  1 = Authorized, 4 = Cancelled -->
            <codingSchemeName>Referral_Status_(NEHR)</codingSchemeName>
            <textDescription>Authorized</textDescription>
          </status>
          <identifier>MDX-GCMS-REF-000000412</identifier>          <!-- [M] card 0..1  String(2000)  [GCMS-NEW] Referral_ID -->
          <type>            <!-- [M] card 0..1  Grouping -->
            <code>4</code>            <!-- [O] card 0..1  String(50)  spec sample: 4 = Consultation -->
            <codingSchemeName>Referral_Type_(NEHR)</codingSchemeName>
            <textDescription>Consultation</textDescription>
          </type>
          <specialty>            <!-- [M] card 0..1  Grouping    Discipline referred TO -->
            <code>NEHR_SS_0002</code>            <!-- [M] card 0..1  String(50)  VERIFY vs Service_Specialty_(NEHR) code-set -->
            <codingSchemeName>Service_Specialty_(NEHR)</codingSchemeName>
            <textDescription>Cardiology</textDescription>
          </specialty>
          <requester>            <!-- [M] card 0..1  Grouping    Referring side (us) -->
            <practitoner>              <!-- sic — spec-mandated spelling -->
              <identifier>04173D</identifier>              <!-- [M] card 0..1  String      MCR -->
              <name>DR RUTH KAM</name>              <!-- [M] card 0..1  String(80) -->
            </practitoner>
            <organisation>              <!-- [M] card 0..1  Grouping -->
              <identifier>9403258</identifier>              <!-- [M] card 0..1  String(50)  our HCI -->
              <name>Ruth Kam Heart and Arrhythmia Clinic</name>              <!-- [M] card 0..1  String(500) -->
            </organisation>
          </requester>
          <recipient>            <!-- [M] card 0..*  Grouping    Receiving side -->
            <!-- practitoner optional: named receiving doctor rarely known
                 at source; omitted here.                                     -->
            <organisation>
              <identifier>0116</identifier>              <!-- [M] card 0..1  String(50)  NHCS HCI — VERIFY actual code -->
              <name>National Heart Centre Singapore</name>
              <type>                <!-- [O] card 0..1  Grouping -->
                <code>2</code>                <!-- [O] card 0..1  String(50)  2 = Healthcare Provider -->
                <codingSchemeName>Organisation_Type_(NEHR)</codingSchemeName>
                <textDescription>Healthcare Provider</textDescription>
              </type>
            </organisation>
          </recipient>
          <encounter>            <!-- [O] card 0..1  Grouping    Visit the referral was raised at -->
